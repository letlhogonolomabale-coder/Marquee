# Copy this file to .env and fill in real values before running.

PORT=4000

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Your Turso database's connection URL and auth token — from the
# "Connect"/"Credentials" section of your database's page at turso.tech.
# The database persists permanently, unlike Render's local disk.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=paste_your_token_here

# Where uploaded ID photos are stored. In production, point this at
# cloud storage (S3, GCS, etc.) instead of local disk — see uploads/README.
UPLOADS_DIR=./uploads

# Comma-separated list of origins allowed to call this API from a browser.
# For local dev with the frontend opened directly as a file, "*" is fine.
CORS_ORIGIN=*
