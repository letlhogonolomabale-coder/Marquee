# Copy this file to .env and fill in real values before running.

PORT=4000

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Your Turso database's connection URL and auth token — from the
# "Connect"/"Credentials" section of your database's page at turso.tech.
# The database persists permanently, unlike Render's local disk.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=paste_your_token_here

# Where uploaded ID photos are stored. In production, point this at
# cloud storage (S3, GCS, etc.) instead of local disk — see uploads/README.
UPLOADS_DIR=./uploads

# Comma-separated list of origins allowed to call this API from a browser.
# For local dev with the frontend opened directly as a file, "*" is fine.
CORS_ORIGIN=*

# --- Boosted events (paid "feature my event" upgrade) ---------------------
# From your Paystack dashboard, Settings > API Keys & Webhooks
# (dashboard.paystack.com/#/settings/developer). Boosting is disabled with
# a clear error until this is set — see utils/paystack.js. Unlike Stripe,
# Paystack uses this SAME key both to call the API and to verify webhooks
# below — there's no separate webhook secret to generate.
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# In that same dashboard page, add a webhook pointed at
# https://your-domain/api/webhooks/paystack. No separate secret to copy —
# Paystack signs webhooks with the PAYSTACK_SECRET_KEY above.

# Your real deployed URL (no trailing slash), used to build the Paystack
# checkout callback link. Falls back to whatever host the request came in
# on if unset, which is fine for local testing but worth setting explicitly
# in production.
PUBLIC_BASE_URL=https://marquee-app.onrender.com

# Optional — override the default R5.00 / 7-day boost. Amount is in cents
# (ZAR's smallest unit, same idea as Stripe's "amount in cents").
# BOOST_PRICE_CENTS=500
# BOOST_DURATION_DAYS=7
